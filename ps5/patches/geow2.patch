+
+// PS5: the console's own libSceHttp (the port's ps5/src/http_ps5.c)
+extern "C" int ps5_http_request(const char* url, const char* body, size_t body_size, const char* bearer,
+                                int timeout_seconds, int* status, char** answer, size_t* answer_size, char* err,
+                                size_t err_size);
