 #include <dlfcn.h>
 
@@ -119,6 +126,30 @@ HttpResponse http_request(const std::string& url, const std::string& body, const
   return r;
 }
 
+#elif defined(__PROSPERO__)
+
+HttpResponse http_request(const std::string& url, const std::string& body, const std::string& bearer,
+                          int timeout_seconds) {
+  HttpResponse r;
+  char* answer = nullptr;
+  size_t size = 0;
+  char err[256] = {};
+  if (ps5_http_request(url.c_str(), body.empty() ? nullptr : body.c_str(), body.size(), bearer.c_str(),
+                       timeout_seconds, &r.status, &answer, &size, err, sizeof(err)) != 0) {
+    r.status = 0;
+    r.error = err;
+    return r;
+  }
+  if (size > kMaxBody) {
+    r.status = 0;
+    r.error = kTooLarge;
+  } else if (answer) {
+    r.body.assign(answer, size);
+  }
+  std::free(answer);
+  return r;
+}
