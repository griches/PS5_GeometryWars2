diff --git a/src/game/font.cpp b/src/game/font.cpp
index 2280fe5..e64804e 100644
--- a/src/game/font.cpp
+++ b/src/game/font.cpp
@@ -167,6 +167,26 @@ Font Font::from_image(std::span<const uint8_t> image) {
   alias(0xD1, 0xF1, 6);
   alias(0xD8, 0xF8, 5);
   alias(0x8C, 0x9C, 1);
+#ifdef __PROSPERO__
+  // PS5: the pad's face buttons as the key tips show them (codes 0x80..0x83,
+  // which neither the font nor the game's text uses): cross, circle, square
+  // and triangle, drawn in the font's own 1 x 1 box
+  auto add = [&](int code, std::vector<std::array<float, 4>> segments) {
+    f.map_[size_t(code)] = uint8_t(f.glyphs_.size());
+    f.glyphs_.push_back(Glyph{code, 1.0f, std::move(segments)});
+  };
+  add(0x80, {{0.1f, 0.1f, 0.9f, 0.9f}, {0.9f, 0.1f, 0.1f, 0.9f}});
+  std::vector<std::array<float, 4>> circle;
+  for (int k = 0; k < 12; ++k) {
+    const float a0 = float(k) * 0.5235988f, a1 = float(k + 1) * 0.5235988f;
+    circle.push_back({0.5f + 0.42f * std::cos(a0), 0.5f + 0.42f * std::sin(a0), 0.5f + 0.42f * std::cos(a1),
+                      0.5f + 0.42f * std::sin(a1)});
+  }
+  add(0x81, std::move(circle));
+  add(0x82, {{0.12f, 0.12f, 0.88f, 0.12f}, {0.88f, 0.12f, 0.88f, 0.88f}, {0.88f, 0.88f, 0.12f, 0.88f},
+             {0.12f, 0.88f, 0.12f, 0.12f}});
+  add(0x83, {{0.5f, 0.08f, 0.95f, 0.88f}, {0.95f, 0.88f, 0.05f, 0.88f}, {0.05f, 0.88f, 0.5f, 0.08f}});
+#endif
   return f;
 }
 
